# ============================================================================
# EDIT FOR YOUR MACHINE -- this unit ships with the author's values.
# Change these before enabling:
#   User=crudobi                                    -> your Linux username
#   EnvironmentFile=/store/muscle/secrets/vault.env -> path to YOUR env file
#                                                     (0600) with KBS_MASTER_PASSWORD
#   ExecStart=... --kdbx /store/muscle/secrets/vault.kdbx
#                    --journal /store/muscle/secrets/sync.db
#                                                   -> YOUR vault and journal paths
#   /usr/local/bin/keepass-bw-sync                  -> path where you installed the binary
# See README.md "Deployment example" for the full setup.
# ============================================================================
[Unit]
Description=KeePass2 <-> Bitwarden sync (offsite backup)
Requires=bw-serve.service
After=bw-serve.service

[Service]
Type=oneshot
User=crudobi
EnvironmentFile=/store/muscle/secrets/vault.env
ExecStart=/usr/local/bin/keepass-bw-sync sync --kdbx /store/muscle/secrets/vault.kdbx --journal /store/muscle/secrets/sync.db
# Default safe flags: no --force, --adopt, or --writeback.
# Foreign Bitwarden edits quarantine for human review.

[Install]
WantedBy=multi-user.target
